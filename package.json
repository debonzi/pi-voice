{
  "name": "pi-voice",
  "version": "0.1.0",
  "description": "Explicit local speech-to-text for Pi on Linux",
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["index.ts", "src", "worker/voice_worker.py", "README.md"],
  "pi": { "extensions": ["./index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -B -m unittest discover -s tests -p 'test_*.py' -q",
    "test:node": "node --test tests/*.test.mjs",
    "test:worker": "python3 -B -m unittest discover -s tests -p 'test_*.py' -q"
  }
}
