{
  "node": "v24.16.0",
  "scope": "E1 fake children only; no audio access",
  "tests": [
    {
      "name": "stop before deferred spawn creates no child or file",
      "passed": true
    },
    {
      "name": "repeated starts and stops settle once; consumed ready WAV is deleted",
      "passed": true
    },
    {
      "name": "stop during STARTING never becomes RECORDING and discards zero-frame fixture",
      "passed": true
    },
    {
      "name": "cancel during starting discards; late ready cannot resurrect recording",
      "passed": true
    },
    {
      "name": "cancel during recording deletes completed bytes instead of publishing",
      "passed": true
    },
    {
      "name": "cancel during finalization wins and start is not queued",
      "passed": true
    },
    {
      "name": "unexpected failure exit 1 with valid bytes never publishes",
      "passed": true
    },
    {
      "name": "spawn ENOENT settles exactly once without a file",
      "passed": true
    },
    {
      "name": "startup deadline cancels instead of simulating release/speech end",
      "passed": true
    },
    {
      "name": "ignored SIGINT escalates to SIGTERM and discards even valid bytes",
      "passed": true
    },
    {
      "name": "ignored graceful signals escalate to SIGKILL; partial file is deleted",
      "passed": true
    },
    {
      "name": "stale callback cannot mutate a new operation",
      "passed": true
    },
    {
      "name": "stdout/stderr flood is drained with bounded retained diagnostics",
      "passed": true
    },
    {
      "name": "disposable owner SIGKILL closes private pipe; supervisor stops/reaps fake",
      "passed": true
    }
  ],
